{
    "name": "dleno/common-core",
    "type": "library",
    "license": "MIT",
    "description": "common core",
    "keywords": ["common-core"],
    "require": {
        "php": ">=8.4",
        "ext-curl": "*",
        "ext-libxml": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-simplexml": "*",
        "ext-swoole": ">=6.2",
        "ext-xml": "*",
        "dleno/dingtalk": "~3.2.0",
        "dleno/hyperf-env-multi": "~3.2.0",
        "hashids/hashids": "^4.1",
        "hyperf/amqp": "~3.2.0",
        "hyperf/async-queue": "~3.2.0",
        "hyperf/cache": "~3.2.0",
        "hyperf/codec": "~3.2.0",
        "hyperf/collection": "~3.2.0",
        "hyperf/command": "~3.2.0",
        "hyperf/config": "~3.2.0",
        "hyperf/context": "~3.2.0",
        "hyperf/contract": "~3.2.0",
        "hyperf/coordinator": "~3.2.0",
        "hyperf/coroutine": "~3.2.0",
        "hyperf/crontab": "~3.2.0",
        "hyperf/database": "~3.2.0",
        "hyperf/db-connection": "~3.2.0",
        "hyperf/di": "~3.2.0",
        "hyperf/engine": "^2.15",
        "hyperf/event": "~3.2.0",
        "hyperf/exception-handler": "~3.2.0",
        "hyperf/framework": "~3.2.0",
        "hyperf/guzzle": "~3.2.0",
        "hyperf/http-message": "~3.2.0",
        "hyperf/http-server": "~3.2.0",
        "hyperf/json-rpc": "~3.2.0",
        "hyperf/logger": "~3.2.0",
        "hyperf/memory": "~3.2.0",
        "hyperf/paginator": "~3.2.0",
        "hyperf/pool": "~3.2.0",
        "hyperf/process": "~3.2.0",
        "hyperf/redis": "~3.2.0",
        "hyperf/rpc-client": "~3.2.0",
        "hyperf/serializer": "~3.2.0",
        "hyperf/server": "~3.2.0",
        "hyperf/signal": "~3.2.0",
        "hyperf/snowflake": "~3.2.0",
        "hyperf/stringable": "~3.2.0",
        "hyperf/support": "~3.2.0",
        "hyperf/validation": "~3.2.0",
        "hyperf/websocket-server": "~3.2.0",
        "jenssegers/optimus": "^1.1",
        "monolog/monolog": "^3.1",
        "nikic/fast-route": "^1.3",
        "php-amqplib/php-amqplib": "^3.5",
        "psr/container": "^1.0 || ^2.0",
        "psr/http-message": "^1.0 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^2.0 || ^3.0",
        "swow/psr7-plus": "^1.0",
        "symfony/property-access": "^6.4 || ^7.0",
        "symfony/serializer": "^6.4 || ^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^1.12",
        "swoole/ide-helper": "^6.2"
    },
    "autoload": {
        "psr-4": {
            "Dleno\\CommonCore\\": "src/"
        },
        "files": [
            "src/common/Functions.php"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "hyperf": {
            "config": "Dleno\\CommonCore\\ConfigProvider"
        }
    },
    "bin": [
    ],
    "scripts": {
        "cs-fix": "php-cs-fixer fix $1",
        "analyse": "phpstan analyse --memory-limit 1G -c phpstan.neon",
        "test": "find src publish examples -name '*.php' -print0 | xargs -0 -n1 php -l"
    }
}
